[Unit]
Description=Fedora Crash Doctor system canary
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/share/fedora-crash-doctor/canary.py
Restart=always
RestartSec=5
Nice=19
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
# tmpfs (not yes) so /run/user can be re-exposed read-only: the canary
# reads the desktop heartbeat from /run/user/<uid>/fedora-crash-doctor/.
# ProtectHome=yes hides /run/user too, so KWin/heartbeat fields were always null.
ProtectHome=tmpfs
BindReadOnlyPaths=-/run/user
PrivateTmp=yes
ReadWritePaths=/var/log/fedora-crash-doctor

[Install]
WantedBy=multi-user.target
